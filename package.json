{
  "name": "dispatchlab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node scripts/migrate.mjs",
    "dev": "node scripts/dev.mjs",
    "serve": "wrangler dev -c apps/worker/wrangler.jsonc -c apps/receiver/wrangler.jsonc --port 8787 --test-scheduled",
    "build": "npm run build -w @dispatchlab/dashboard && npm run bundle",
    "bundle": "wrangler deploy -c apps/worker/wrangler.jsonc --dry-run --outdir .build/worker && wrangler deploy -c apps/receiver/wrangler.jsonc --dry-run --outdir .build/receiver",
    "typecheck": "tsc --noEmit && npm run typecheck -w @dispatchlab/dashboard",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.5",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
