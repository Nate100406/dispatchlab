{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/workers-types"],
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/worker/**/*.ts",
    "apps/receiver/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ]
}
